# Copy this file to .env and fill in the values. Never commit .env.

# Neon PostgreSQL connection string.
# Neon console -> your project -> Connect -> choose the *pooled* connection.
# On Vercel, set the same variable in Project Settings -> Environment Variables
# (the Neon integration for Vercel adds DATABASE_URL automatically).
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
